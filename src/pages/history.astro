const sunsplashPhoto = env ? await getImageById(env, 'ceb5a659-f09c-4667-80c5-82a9c721bfaf') : null;
---

<BaseLayout title="History | Twinkle Brothers" description="The story of the Twinkle Brothers reggae band, from Falmouth, Jamaica to the world stage. Six decades of conscious music, Rastafarian conviction, and international touring.">
  <div class="pt-24 max-w-3xl mx-auto px-6 pb-24">

    <h1 class="font-display text-5xl md:text-7xl tracking-widest uppercase text-white mb-16">History</h1>

    <!-- INTRO -->
    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        Norman and Ralston Grant formed the Twinkle Brothers in Falmouth, on Jamaica's north coast, in 1962. Norman was twelve and Ralston fourteen and Jamaica became independent that August. The brothers had been singing together for a few years by then, first in the Anglican Sunday school choir and then in talent competitions that were, for young performers outside Kingston, the most reliable way of being heard.
      </p>
      <p>
        The Twinkle Brothers band are still hard at work. Norman runs the band from London, and most of the catalogue, now past sixty albums, has come out on the Twinkle label that he set up in Jamaica in the early 1970s.
      </p>
    </div>

    <!-- PULL QUOTE -->
    <blockquote class="not-prose my-12 relative">
      <span class="absolute -top-2 -left-2 font-serif text-[8rem] md:text-[10rem] leading-none text-amber-dark/25 select-none" aria-hidden="true">"</span>
      <p class="relative pl-16 md:pl-20 text-2xl md:text-3xl text-amber-dark font-bold italic leading-snug font-serif">To be independent in music, you don't have a company to tell you what to sing. Independently, you're singing from your heart.</p>
      <cite class="block mt-4 pl-16 md:pl-20 text-amber-dark/50 text-sm not-italic font-serif">Norman Grant</cite>
    </blockquote>

    <!-- SECTION: FALMOUTH -->
    <h2 class="text-3xl md:text-4xl text-white font-bold mt-16 mb-6" style="font-family: var(--font-heading-serif);">Falmouth</h2>
    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        Falmouth is a small port town, the parish capital of Trelawny, the same parish that later produced Usain Bolt. The Grant brothers grew up there in what Norman describes as "poor but happy" - two families sharing one kitchen, ten shillings a month in rent, the sea on one side and the country on the other. They were baptised in the Anglican church and put into the Sunday school choir, Ralston at eight and Norman at six.
      </p>
      <p>
        There was a Pocomania church close by holding service every day, so there was drumming most mornings, and on the corner, as Norman remembers it, somebody was always playing. A man in the neighbourhood organised the children into concerts and taught them to get their lines together, which is where Norman started writing. The <a href="https://en.wikipedia.org/wiki/Junkanoo" rel="noopener" class="text-accent hover:text-accent-light transition-colors">Junkanoo</a> processions came through at Christmas. At home their grandfather played the fiddle and their father sang Jamaican folk songs during weekend beach trips. "We learn from their voices" Norman has said. "They sing, and lots of other people sing, your neighbour sings, so you just catch bits"
      </p>
      <p>
        They had no money for instruments, so they made them themselves. Norman went through the rubbish for cans and pans, knocking them to hear which sizes gave a good sound. Milk cans and old frying pans became a drum kit, a guitar came from a sardine tin strung with line salvaged from broken fishing tackle. "You put the string on and you get a sound" he says. "So that's where it started". Ralston took the guitar, Norman the drums. A "chimmy", the Jamaican word for a chamber pot, ended up as a percussion instrument. "A lot of Jamaican bands, that's where they started" he says. "Making their own equipment, because we didn't have money, or anybody to give us any".
      </p>
      <p>
        The group's name came from a Rastaman the brothers knew as Some-me-say, who heard them rehearsing one evening in Falmouth and told them to call themselves the Twinkle Brothers and it just stuck.
      </p>
    </div>

    <!-- SECTION: THE FESTIVALS -->
    <h2 class="text-3xl md:text-4xl text-white font-bold mt-16 mb-6" style="font-family: var(--font-heading-serif);">Independence and the Festivals</h2>
    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        "We heard we were getting independence, we're going to be our own nation" Norman said. The practical form that took, for two boys in Trelawny, was the Jamaica Pop and Mento Festival, which the government launched the same year.
      </p>
      <p>
        The competition ran from parish level through regional heats to the final in Kingston. They won at parish level on their first entry, then went through to the heats against St James, St Elizabeth, Hanover and Westmoreland. At the regional final in Montego Bay the judges' decision went against them to a booing crowd, and the same thing happened in 1963.
      </p>
      <p>
        On the third attempt, in 1964, they took the regional heat and went on to Kingston, where they won in the group category and Norman won in the solo category too.
      </p>
      <p>
        By 1968, six years into competition, they left the All Island Festival with two gold medals on the same night, one as the Twinkle Brothers and one for Norman as a solo performer.
      </p>
      <p>
        The festival was not only for amateurs. Toots and the Maytals entered the professional side four or five times, as Norman remembers it. He thought at the time that it might be the start of something larger, that a singer popular in Jamaica could send the music abroad and be popular there too. "We say, well, we could start an industry" he said. "But it didn't turn out the way we thought"
      </p>
    </div>

    <!-- PULL QUOTE -->
    <blockquote class="not-prose my-12 relative">
      <span class="absolute -top-2 -left-2 font-serif text-[8rem] md:text-[10rem] leading-none text-amber-dark/25 select-none" aria-hidden="true">"</span>
      <p class="relative pl-16 md:pl-20 text-2xl md:text-3xl text-amber-dark font-bold italic leading-snug font-serif">That creativeness bloomed in all of us. We said, okay, we're on our own now. We can do our own thing.</p>
      <cite class="block mt-4 pl-16 md:pl-20 text-amber-dark/50 text-sm not-italic font-serif">Norman Grant</cite>
    </blockquote>

    <!-- SECTION: KINGSTON -->
    <h2 class="text-3xl md:text-4xl text-white font-bold mt-16 mb-6" style="font-family: var(--font-heading-serif);">Kingston: Studios and the Hotel Circuit</h2>
    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        By the mid 1960s the brothers were working two circuits at once. The tourist hotels on the north coast paid but it was the capital Kingston, where the records were made.
      </p>
      <p>
        The hotel work came through the Cardinals, a respectable Falmouth band made up of lawyers, accountants and teachers. Norman and Ralston were, as Norman puts it, "the only ghetto youths in the band". They played the hotels in Montego Bay, Lucea, Negril and Ocho Rios, six nights a week, and went to school in the daytime.
      </p>
      <p>
        The repertoire was whatever was in fashion at the time - calypso and soul, Beatles ballads, James Brown, Smokey Robinson, the Impressions, the Temptations. Norman took it as an apprenticeship. "Knowing all those melodies helps you create your own style" he says, "and helps you not to clash with music that's already made".
      </p>
      <p>
        The Cardinals broke up and some of the same musicians formed Schubert and the Miracles. From there the brothers moved to the Celestial band in Montego Bay, where Norman was paid properly for the first time, around £20 a week, good money then. He stayed about eight years, entering the festival in the same period. The band recorded two albums for the tourist trade, sold in the hotels, on one of them Norman recorded "Little Green Apples" before Dennis Brown's version.
      </p>
      <p>
        Kingston was harder to break into though. Ralston had spent time at Cobbler Camp, a technical college where students could train as electricians and in other trades, and it was there he met Aston "Family Man" Barrett, the future Wailers bassist, singing in the choir. Norman stayed with an aunt and other relatives in August Town and Trenchtown, sleeping on floors and living on whatever was going. "Mi just eat dumpling and butter" as he later put it.
      </p>
      <p>
        They queued for auditions at every label that would see them. At Prince Buster's studio they were picked to record, then the Maytals ran over their session and that was the end of it. "We never got to record," Ralston recalls. The same thing happened at Studio One. Duke Reid gave them their first group single in 1966, <a href="/discography/8061322" class="text-accent hover:text-accent-light">"Matthew, Mark, Luke And John"</a> - he liked it, and told them they had "a nice little Christian song".
      </p>
      <p>
        At Treasure Isle there were no headphones for monitoring at that time. "There was kind of technique that you have to start to use, where you stand with your back to the piano" he says. Duke Reid rarely set foot in the studio himself, but he did that day, Ernest Ranglin remarking that he must have liked the tune to have come in for it. They were paid in six copies of the record rather than cash. In those Kingston years they met Bob Marley, Desmond Dekker, Alton Ellis and Jimmy Cliff.
      </p>
      <p>
        In 1970 they placed third in the Jamaica Festival Song Contest, and the six finalists were told to present themselves to the producer Bunny Lee the following morning. They went to Randy's Studio at 17 North Parade and had the song recorded, mastered and pressed inside two days, with Family Man and his brother Carlton on the session. Those were the first sessions the Soul Syndicate ever played together. Lee cut around fourteen songs with them. Lee also taught them about PRS, publishing, booking studios and ownership.
      </p>
      <p>
        Norman went further and asked Family Man and Carlton directly what they charged for a session, the hotel work meant he could start paying from sessions for the band.
      </p>
      <p>
        By 1974 they were booking sessions under their own steam, with Sly Dunbar on drums, Lloyd Parks on bass and Ansell Collins on keyboards. That year they became the first act ever to rent Treasure Isle outright from Duke Reid, who had never let the room to anyone else. They had recorded there before, but for Duke Reid's own sessions, including "I Love You So" in 1971. <a href="/discography/2025281" class="text-accent hover:text-accent-light">"Jahovia"</a> followed in 1978, cut in the same room with the Barrett brothers on drum and bass.
      </p>
    </div>

    <!-- IMAGE PLACEHOLDER: Early Falmouth / Jamaica compound life -->
    <!-- Suggested: archival photo of Falmouth, or early portrait of the brothers -->
    {earlyYearsPhoto ? (
      <figure class="not-prose my-12">
        <a href={`/image/${earlyYearsPhoto.id}?from=photo`}>
          <img
            src={`/cdn/${thumbKey(earlyYearsPhoto.r2_key)}`}
            alt={earlyYearsPhoto.caption || ''}
            class="w-full rounded-lg hover:opacity-90 transition-opacity"
          />
        </a>
      </figure>
    ) : null}

    <!-- SECTION: RASTA AND ROOTS -->
    <h2 class="text-3xl md:text-4xl text-white font-bold mt-16 mb-6" style="font-family: var(--font-heading-serif);">Rasta and Roots</h2>
    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        Ralston was outside before dawn in Falmouth in 1974, looking at a full moon. In the shadow of a cloud crossing it, Haile Selassie appeared, and then the face turned into a child of about ten. "I was kind of scared to go back in the house," he recalls. "I come back out and I look up again and I said, well, stick to the locks". Norman's path had been longer and quieter. There had been Rastamen around Falmouth since he was fourteen, and Selassie had visited Jamaica in 1966, by which time Norman was already recording. "It was about self-reliance".
      </p>
      <p>
        <a href="/discography/220933" class="text-accent hover:text-accent-light">"Rasta Pon Top"</a> came out on the independent UK label Grounation in 1975. Five thousand copies was a good sale for a reggae LP in Britain then. The tracks were not coded: "Give Rasta Praise", <a href="/discography/773819" class="text-accent hover:text-accent-light">"Beat Them Jah Jah"</a>. The band that had come up through the Sunday school choir and the hotel lounges was now openly Rastafarian. "We were going to the studio singing 'I'm hungry, fire for Babylon,'" Ralston said. "Sad songs, but we're happy, dancing off the sadness. For some reason the world loved it!"
      </p>
    </div>

    <!-- PULL QUOTE -->
    <blockquote class="not-prose my-12 relative">
      <span class="absolute -top-2 -left-2 font-serif text-[8rem] md:text-[10rem] leading-none text-amber-dark/25 select-none" aria-hidden="true">"</span>
      <p class="relative pl-16 md:pl-20 text-2xl md:text-3xl text-amber-dark font-bold italic leading-snug font-serif">These songs are not going to tell you to take a gun and kill that man because he is wicked. We can tell you that you're wicked, with a smile.</p>
      <cite class="block mt-4 pl-16 md:pl-20 text-amber-dark/50 text-sm not-italic font-serif">Ralston Grant</cite>
    </blockquote>

    <!-- SECTION: LOS ANGELES AND SUNSPLASH -->
    <h2 class="text-3xl md:text-4xl text-white font-bold mt-16 mb-6" style="font-family: var(--font-heading-serif);">Los Angeles and Sunsplash</h2>
    <div class="prose prose-invert prose-lg max-w-none">
      {roxyPoster && (
        <figure class="not-prose float-right ml-8 mb-4 w-1/3">
          <button id="roxy-poster-btn" class="block w-full cursor-zoom-in" aria-label="View poster full size">
            <img
              src={`/cdn/${thumbKey(roxyPoster.r2_key)}`}
              alt={roxyPoster.caption || 'Twinkle Brothers first US performance poster, Roxy LA 1980'}
              class="w-full rounded-lg hover:opacity-90 transition-opacity"
            />
          </button>
          <figcaption class="text-zinc-500 text-xs mt-2 text-center">First US show, The Roxy, Los Angeles, 2 November 1980</figcaption>
        </figure>
      )}
      <p>
        The Twinkle Brothers played their first American show at the Roxy on Sunset Strip on 2 November 1980. Norman had come over singing with Inner Circle, who carried on touring the States after Jacob Miller was killed that March. At the Roxy the band were still setting up when Roger Steffens, who had been collecting and broadcasting Jamaican music for years, came out onto the stage. John Belushi was in the room that night.
      </p>
      <p>
        They were back in 1982, with reggae opening up in America after Bob Marley's death the year before. UCLA students and West Coast collectors had been following the records from a distance. "When Twinkle Brothers came back," Norman recalled, "they said I never knew you were so great live." Across the American visits they also played the Country Club and the Olympic Auditorium.
      </p>
      <p>
        Matt Groening had a weekly music column in the LA Reader from 1982, some years before The Simpsons. He became a regular at Twinkle Brothers shows and reviewed them more than once. What struck him was the gap between the records and the band on stage. "Fans who had only heard the records" he wrote, "were surprised by the group's intensity and wit".
      </p>
      <div class="clear-both"></div>
    </div>

    {groeningArticle && (
      <figure class="not-prose my-12">
        <a href={`/image/${groeningArticle.id}?from=photo`}>
          <img
            src={`/cdn/${thumbKey(groeningArticle.r2_key)}`}
            alt="Matt Groening review of Twinkle Brothers, LA Reader"
            class="w-full rounded-lg hover:opacity-90 transition-opacity"
          />
        </a>
        <figcaption class="text-zinc-500 text-sm mt-3 text-center">Matt Groening, then a music critic for the LA Reader, later creator of The Simpsons</figcaption>
      </figure>
    )}

    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        Norman did not take to the country. "America is too big" he said. "Reggae is not popular in every state. You maybe have to pass one, two state to go to the state that reggae is popular, and the travelling for me is too long". In England the music had arrived before he did, whereas in America he had to play to make his name.
      </p>
      <p>
        In August 1982 they played Reggae Sunsplash at Jarrett Park in Montego Bay, Sunsplash then at its height. After years of building an audience abroad they came home as an international touring act. The show was filmed and the audio released on LP. It remains the last time the Twinkle Brothers have performed in Jamaica.
      </p>
    </div>

    {sunsplashPhoto && (
      <figure class="not-prose my-12">
        <a href={`/image/${sunsplashPhoto.id}?from=photo`}>
          <img
            src={`/cdn/${thumbKey(sunsplashPhoto.r2_key)}`}
            alt={sunsplashPhoto.caption || 'Reggae Sunsplash, Jarrett Park, Montego Bay, 1982'}
            class="w-full rounded-lg hover:opacity-90 transition-opacity"
          />
        </a>
        {sunsplashPhoto.caption && (
          <figcaption class="text-zinc-500 text-sm mt-3 text-center">{sunsplashPhoto.caption}</figcaption>
        )}
      </figure>
    )}

    <!-- SECTION: LONDON, FRONT LINE AND JAH SHAKA -->
    <h2 class="text-3xl md:text-4xl text-white font-bold mt-16 mb-6" style="font-family: var(--font-heading-serif);">London, Front Line and Jah Shaka</h2>
    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        Norman had been making regular trips to England since 1975. From 1976 the label Carib Gems was distributing his music there, releasing <a href="/discography/650282" class="text-accent hover:text-accent-light">"Do Your Own Thing"</a> the following year. Then letters began arriving to say his songs were being pirated. In 1978 he flew over with four songs. A reggae A&R man known as Wenty put him in front of Virgin, then a young independent operating out of Portobello Road, and he played the tracks to a room of about ten people that included the label's co-founders Simon Draper and Richard Branson. Virgin released <a href="/discography/326725" class="text-accent hover:text-accent-light">"Love"</a>, the first 10-inch reggae record issued in England.
      </p>
      {shakaPhoto ? (
        <figure class="not-prose my-12">
          <a href={`/image/${shakaPhoto.id}?from=photo`}>
            <img
              src={`/cdn/${thumbKey(shakaPhoto.r2_key)}`}
              alt={shakaPhoto.caption || ''}
              class="w-full rounded-lg hover:opacity-90 transition-opacity"
            />
          </a>
          <figcaption class="text-zinc-500 text-sm mt-3 text-center">Jah Shaka and Norman at The Albany, Deptford, 1988. Photo by David Corio.</figcaption>
        </figure>
      ) : null}
      <p>
        Virgin was the third English deal Norman signed and the best of them. "They put us in a market where maybe we couldn't put ourselves," he says. The contract ran five years for three LPs, through the Front Line imprint. The punk audience had taken to roots the way the skinheads had taken to ska, and Virgin put them on the same compilations: the Sex Pistols, the Twinkle Brothers and the Gladiators on one record. Front Line released <a href="/discography/247510" class="text-accent hover:text-accent-light">"Praise Jah"</a> and <a href="/discography/220935" class="text-accent hover:text-accent-light">"Countrymen"</a> and gave the band five sessions across the decade, then cancelled early and shut the reggae operation down.
      </p>
      <p>
        Norman has not approached a record company since. He put the music out on Twinkle, the label he had set up in Jamaica in 1971 and now ran from England; the first UK release was <a href="/discography/247513" class="text-accent hover:text-accent-light">"Me No You - You No Me"</a> in 1981. The first dedicated UK tour came the same year.
      </p>
      <figure class="not-prose float-right ml-8 mb-4 w-1/2">
        <button id="shaka-shop-btn" class="block w-full cursor-zoom-in" aria-label="View photo full size">
          <img
            src="/russ_arts_craft_culture.jpg"
            alt="Jah Shaka's Arts, Craft and Culture shop in New Cross, South East London, 1980s, with a young Russ Disciple standing outside"
            class="w-full rounded-lg hover:opacity-90 transition-opacity"
          />
        </button>
        <figcaption class="text-zinc-500 text-xs mt-2 text-center">Jah Shaka's Arts, Craft and Culture shop, New Cross, with a young Russ Disciple standing outside, 1980s</figcaption>
      </figure>
      <p>
        After America and Sunsplash, Norman made England his home. His friendship with <a href="https://en.wikipedia.org/wiki/Jah_Shaka" target="_blank" rel="noopener" class="text-accent hover:text-accent-light">Jah Shaka</a> went back years by then. Shaka, born Neville Powell in Clarendon, ran his sound out of South East London, and his dances had become an institution; the sound's influence carried on into jungle, drum and bass and dubstep. He also kept the Culture Shop in New Cross, part record shop, part Caribbean food counter, part Rastafari hair salon. The Twinkle Brothers were a fixture of his selection, Norman a constant presence at the dances, and Shaka would come looking for him whenever he wanted new dubplates.
      </p>
      <p>
        They cut "Revelation 18" together in the early 1980s. Shaka played the bass on it. He had picked the instrument up while the band's own bassist was in the toilet, and that was the take.
      </p>
      <p>
        Norman took up UK residency in 1986.
      </p>
      <div class="clear-both"></div>
    </div>

    <!-- SECTION: POLAND -->
    <h2 class="text-3xl md:text-4xl text-white font-bold mt-16 mb-6" style="font-family: var(--font-heading-serif);">Poland and the Tatra Mountains</h2>
    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        When Norman was ten or eleven, the cheapest shoes in Jamaica, strong durable leather, came from Poland. He would not set foot in the country until he was thirty-eight.
      </p>
      <p>
        Władek Kliszcz worked for Polish state radio and came to London in 1986 on holiday, knowing that Jamaican artists had been settling in England. He tracked Norman down and interviewed him at Jah Shaka's Culture Shop, with a simple message: the Twinkle Brothers were popular in Poland and Norman should come and see for himself. Norman's objection was money. Kliszcz told him he would be paid.
      </p>
      <p>
        He arrived in 1988, to a country still under Communist rule, Solidarity alive in the streets, soldiers at the airport, and young people cheering from the pavements as the car moved through the city. The studio was the surprise: a 24-track room for £1.20 an hour, when England was charging at least £24. Norman made eight albums there. He was paid in millions of złoty that could not leave the country, so he spent it, on a trombone, a trumpet, about fifteen leather coats that cost him around £5 each and sold in London for £85, leather skirts that went to Jamaica. He carried it home in three suitcases. "If I never count millions again," he said in 2023, "I've counted millions in Poland."
      </p>
      <p>
        The Solidarity connection went back further than his first visit. The band had been following what was happening in Poland on the news, and in 1984 an underground LP came out there with the Solidarity logo on the cover, pressed outside official channels and circulated through the networks keeping the movement alive. Later he played shows for Solidarity himself.
      </p>

    {polandStill && (
      <figure class="not-prose my-12">
        <a href="https://youtu.be/keUOiCcHtoQ?t=2766" target="_blank" rel="noopener" class="block group">
          <div class="relative">
            <img
              src={`/cdn/${thumbKey(polandStill.r2_key)}`}
              alt="Still from Girl Guide (1995), Twinkle Brothers and Trebunie-Tutki, Zakopane, Poland"
              class="w-full rounded-lg group-hover:opacity-80 transition-opacity"
            />
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
              <span class="bg-black/70 text-white text-sm font-sans px-4 py-2 rounded-full">Watch on YouTube</span>
            </div>
          </div>
        </a>
        <figcaption class="text-zinc-500 text-sm mt-3 text-center">Still from <em>Girl Guide</em> (1995), Twinkle Brothers and Trebunie-Tutki, Zakopane. <a href="https://youtu.be/keUOiCcHtoQ?t=2766" target="_blank" rel="noopener" class="text-zinc-400 hover:text-white underline underline-offset-2">Watch on YouTube</a></figcaption>
      </figure>
    )}

      <p>
        Kliszcz also introduced Norman to Trebunie-Tutki, a family band from Zakopane in the Tatra Mountains who played traditional Polish highland music. Norman and the bassist Dub Judah travelled there and lived with the family for a week, eating, sleeping and rehearsing in the house, with Anna, the sixteen-year-old daughter of the group's leader Władysław Trebunia-Tutka, translating. At Spirit Studio in Zakopane, ganja growing in the garden outside, Norman told Judah how they were going to approach the recording: "We have to create our own beat. Don't follow them." They laid bass and drum down first and brought the violins in on top.
      </p>
      <p>
        They made four albums together. The Twinkle Brothers went to number one on Polish radio, above Michael Jackson. A TVP documentary, <em>Higher Heights</em>, filmed them in Zakopane in 1992, and the <a href="/discography/209453" class="text-accent hover:text-accent-light">album</a> followed in 1993. The band appeared in a Polish film, <a href="https://youtu.be/keUOiCcHtoQ?t=2766" target="_blank" rel="noopener" class="text-accent hover:text-accent-light">"Girl Guide"</a>, in 1995. <a href="/discography/4790056" class="text-accent hover:text-accent-light">"Songs Of Glory · Pieśni Chwały"</a> came out in 2008 and went gold.
      </p>
      <p>
        The money Norman accumulated in Poland funded the purchase of his London recording studio in 1995. "Even that," he said, "is another memory for Poland."
      </p>
    </div>


    <!-- PULL QUOTE -->
    <blockquote class="not-prose my-12 relative">
      <span class="absolute -top-2 -left-2 font-serif text-[8rem] md:text-[10rem] leading-none text-amber-dark/25 select-none" aria-hidden="true">"</span>
      <p class="relative pl-16 md:pl-20 text-2xl md:text-3xl text-amber-dark font-bold italic leading-snug font-serif">If I never count millions again, I've counted millions in Poland.</p>
      <cite class="block mt-4 pl-16 md:pl-20 text-amber-dark/50 text-sm not-italic font-serif">Norman Grant</cite>
    </blockquote>

    <!-- SECTION: STILL WORKING -->
    <h2 class="text-3xl md:text-4xl text-white font-bold mt-16 mb-6" style="font-family: var(--font-heading-serif);">Still Working</h2>
    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        The Twinkle Brothers still perform and record, with Norman leading. The line-up around him has taken four decades to assemble.
      </p>
    </div>

    {legacyPhoto ? (
      <figure class="not-prose my-12">
        <a href={`/image/${legacyPhoto.id}?from=photo`}>
          <img
            src={`/cdn/${thumbKey(legacyPhoto.r2_key)}`}
            alt={legacyPhoto.caption || ''}
            class="w-full rounded-lg hover:opacity-90 transition-opacity"
          />
        </a>
        {legacyPhoto.caption && (
          <figcaption class="text-zinc-500 text-sm mt-3 text-center">{legacyPhoto.caption}</figcaption>
        )}
      </figure>
    ) : null}

    <div class="prose prose-invert prose-lg max-w-none">
      <p>
        Norman has run the band from the UK since 1986, writing the lyrics and leading the touring operation. Ralston, based in Oakland, has gone on recording for the Twinkle label from his own studio there, and his voice carries some of the catalogue's best-known tracks, including the lead vocal on <a href="/discography/2025281" class="text-accent hover:text-accent-light">"Jahovia"</a>. The bassist <strong>Dub Judah</strong>, in the band since 1990, is a UK dub producer and recording artist in his own right, and the same musician who went to Zakopane and laid the foundation the Trebunie-Tutki violins were built on. The guitarist <strong>Black Steel</strong>, there since 1986, is a UK lovers rock and roots multi-instrumentalist whose credits include Mad Professor and Jah Shaka. <strong>Jerry Lions</strong>, also on guitar, joined in 1987 and is a long-standing reggae producer and former member of the Fasimbas. <strong>Derek "Demondo" Fevrier</strong> has engineered for the band since 1986. The keyboard player <strong>Aron Shamash</strong> and the drummer <strong>Barry Prince</strong> both joined in 2004.
      </p>
      <p>
        The band has not played Jamaica since Sunsplash in 1982. Since then the work has taken them across the West Coast of the United States, Brazil, Chile and South Africa, and through most of the major European festivals, including Rototom Sunsplash, Outlook, Shambala and the Ostróda Reggae Festival, with regular dates in Germany, Poland, Spain and France, where the following has been steadiest. In the United States they have played Reggae on the River.
      </p>
      <p>
        Norman, now in his seventies, has been putting down roots in Jamaica again. He has built a house with a performance space on the top floor and runs a youth club there of the kind he used as a boy in Trelawny. He makes music every day. Asked about playing in Jamaica again, he says: "It's getting to the time now."
      </p>
    </div>

    {closingPhoto && (
      <figure class="not-prose my-12">
        <a href={`/image/${closingPhoto.id}?from=photo`}>
          <img
            src={`/cdn/${thumbKey(closingPhoto.r2_key)}`}
            alt={closingPhoto.caption || ''}
            class="w-full rounded-lg hover:opacity-90 transition-opacity"
          />
        </a>
        {closingPhoto.caption && (
          <figcaption class="text-zinc-500 text-sm mt-3 text-center">{closingPhoto.caption}</figcaption>
        )}
      </figure>
    )}

  </div>
</BaseLayout>

{roxyPoster && (
  <div id="roxy-lightbox" class="fixed inset-0 z-50 bg-black/95 hidden flex-col items-center justify-center p-4 md:p-8" role="dialog" aria-modal="true" aria-label="Poster full view">
    <button id="roxy-lightbox-close" class="absolute top-4 right-4 text-zinc-400 hover:text-white transition-colors" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <img
      src={`/cdn/${roxyPoster.r2_key}`}
      alt={roxyPoster.caption || 'Twinkle Brothers first US performance poster, Roxy LA 1980'}
      class="max-h-[85vh] max-w-full object-contain rounded"
    />
    <p class="text-zinc-400 text-sm mt-4 text-center">First US show, The Roxy, Los Angeles, 2 November 1980</p>
  </div>
)}

<div id="shaka-shop-lightbox" class="fixed inset-0 z-50 bg-black/95 hidden flex-col items-center justify-center p-4 md:p-8" role="dialog" aria-modal="true" aria-label="Photo full view">
  <button id="shaka-shop-lightbox-close" class="absolute top-4 right-4 text-zinc-400 hover:text-white transition-colors" aria-label="Close">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <img
    src="/russ_arts_craft_culture.jpg"
    alt="Jah Shaka's Arts, Craft and Culture shop in New Cross, South East London, 1980s, with a young Russ Disciple standing outside"
    class="max-h-[85vh] max-w-full object-contain rounded"
  />
  <p class="text-zinc-400 text-sm mt-4 text-center">Jah Shaka's Arts, Craft and Culture shop, New Cross, with a young Russ Disciple standing outside, 1980s</p>
</div>

<script>
  function wireLightbox(btnId: string, lightboxId: string, closeBtnId: string) {
    const btn = document.getElementById(btnId);
    const lightbox = document.getElementById(lightboxId);
    const closeBtn = document.getElementById(closeBtnId);

    const open = () => {
      lightbox?.classList.remove('hidden');
      lightbox?.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox?.classList.add('hidden');
      lightbox?.classList.remove('flex');
      document.body.style.overflow = '';
    };

    btn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  wireLightbox('roxy-poster-btn', 'roxy-lightbox', 'roxy-lightbox-close');
  wireLightbox('shaka-shop-btn', 'shaka-shop-lightbox', 'shaka-shop-lightbox-close');
</script>
