// eslint-disable-next-line @typescript-eslint/no-explicit-any
const env = (Astro.locals as any).runtime?.env;
const roxyPoster = env ? await getImageById(env, '3a8c4737-a339-48e2-b21b-b927a957b7f5') : null;
const earlyYearsPhoto = env ? await getImageById(env, '3daadd55-647d-484f-a4ba-79d74b91e91a') : null;
const legacyPhoto = env ? await getImageById(env, 'f1b4484b-6718-4b1f-8447-e00532099499') : null;
const shakaPhoto = env ? await getImageById(env, '89ccc6d1-1efc-43ba-8fc2-c2110e0cf324') : null;
const polandStill = env ? await getImageById(env, '158d1ec6-8906-4415-9eea-31f8eae163a0') : null;
